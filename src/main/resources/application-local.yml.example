# 이 파일을 application-local.yml 로 복사해서 각자 값을 채우십시오.
# application-local.yml 은 커밋되지 않습니다 (.gitignore).
#
# ★ 2026-08-18 부터 H2 를 쓰지 않습니다. 로컬에도 MySQL 이 있어야 합니다.
#   1. MySQL 8.0.16 이상 설치
#   2. CREATE DATABASE fromnowon_db DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   3. docs/schema_v63.sql 적용 → 테이블 22 · 외래키 28 · CHECK 23 확인
#   4. 이 파일을 복사해 아래 값을 채우기

spring:
  datasource:
    # MySQL 8.0.16 이상. serverTimezone 을 빠뜨리면 「오늘」이 하루 어긋납니다
    url: jdbc:mysql://localhost:3306/fromnowon_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: 여기에
    password: 여기에

app:
  cors:
    origins: http://localhost:5173
  jwt:
    secret: 32바이트가_넘는_아무_문자열이나_여기에_적으십시오

  # LLM — 안 적어도 됩니다.
  #
  # 비워 두면 AI 호출이 처음부터 폴백으로 갑니다. 화면은 정상이고
  # generatedBy 에 fallback 이 남습니다. 개발 중에는 이 상태로 충분합니다.
  #
  # 실제로 AI 를 돌려 보고 싶으면 팀 OpenAI 키를 여기에 적으십시오.
  # ★ 이 파일은 커밋되지 않지만, 그래도 키를 스크린샷·채팅에 올리지 마십시오.
  #
  # 실서버에서는 이 자리를 환경 변수로 채웁니다.
  #   FROMNOWON_OPENAI_API_KEY · FROMNOWON_OPENAI_MODEL
  llm:
    api-key:
    model: gpt-5.6-luna
