# 이 파일을 application-local.yml 로 복사해서 각자 값을 채우십시오.
# application-local.yml 은 커밋되지 않습니다 (.gitignore).

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/now
    username: 여기에
    password: 여기에

app:
  cors:
    origins: http://localhost:5173
  jwt:
    secret: 32바이트가_넘는_아무_문자열이나_여기에_적으십시오
  llm:
    api-key: 여기에
